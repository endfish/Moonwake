<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Moonwake</AssemblyName>
    <RootNamespace>Moonwake</RootNamespace>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Authors>Endfish</Authors>
    <Product>Moonwake</Product>
    <Description>Independent Dalamud injection tool for the CN FFXIV client.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\app-icon.png" />
    <EmbeddedResource Include="Resources\window-background.png" />
    <InternalsVisibleTo Include="Moonwake.Tests" />
  </ItemGroup>
</Project>
