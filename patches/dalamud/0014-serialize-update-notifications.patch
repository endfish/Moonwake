+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+using Dalamud.Plugin.Internal.AutoUpdate;
+
+using Xunit;
+
+namespace Dalamud.Test.Plugin;
+
+public class PeriodicUpdateCheckTests
+{
+    [Fact]
+    public void SlowRefreshAcrossManyFramesProducesOnlyOneResult()
+    {
+        var check = new PeriodicUpdateCheck();
+        var completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var requests = 0;
+        Task Reload() { requests++; return completion.Task; }
+
+        Assert.True(check.TryStart(Reload));
+        for (var frame = 0; frame < 600; frame++)
+        {
+            Assert.False(check.TryStart(Reload));
+            Assert.False(check.TryComplete(out _));
+        }
+
+        completion.SetResult();
+        Assert.True(check.IsPending);
+        Assert.False(check.TryStart(Reload));
+        Assert.True(check.TryComplete(out var error));
+        Assert.Null(error);
+        Assert.Equal(1, requests);
+        for (var frame = 0; frame < 600; frame++)
+            Assert.False(check.TryComplete(out _));
+        Assert.False(check.IsPending);
+        Assert.True(check.TryStart(() => Task.CompletedTask));
+        Assert.True(check.TryComplete(out error));
+        Assert.Null(error);
+    }
+
+    [Fact]
+    public void CompletedRefreshWaitsForConsumerBeforeAnotherCanStart()
+    {
+        var check = new PeriodicUpdateCheck();
+        Assert.True(check.TryStart(() => Task.CompletedTask));
+        Assert.False(check.TryStart(() => throw new Exception("Must not start again")));
+        Assert.True(check.TryComplete(out var error));
+        Assert.Null(error);
+        Assert.False(check.TryComplete(out _));
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void FailedRefreshIsObservedOnceAndAllowsLaterRetry(bool synchronous)
+    {
+        var check = new PeriodicUpdateCheck();
+        var failure = new InvalidOperationException("Repository unavailable");
+        Assert.True(check.TryStart(() => synchronous ? throw failure : Task.FromException(failure)));
+        Assert.False(check.TryStart(() => Task.CompletedTask));
+        Assert.True(check.TryComplete(out var error));
+        Assert.Same(failure, error);
+        Assert.False(check.TryComplete(out _));
+        Assert.True(check.TryStart(() => Task.CompletedTask));
+        Assert.True(check.TryComplete(out error));
+        Assert.Null(error);
+    }
+
+    [Fact]
+    public void CancelledRefreshIsObservedWithoutProducingASuccessResult()
+    {
+        var check = new PeriodicUpdateCheck();
+        Assert.True(check.TryStart(() => Task.FromCanceled(new CancellationToken(true))));
+        Assert.True(check.TryComplete(out var error));
+        Assert.IsAssignableFrom<OperationCanceledException>(error);
+        Assert.False(check.TryComplete(out _));
+        Assert.False(check.IsPending);
+    }
+}
