--- /dev/null
+++ b/Dalamud/Plugin/Internal/AutoUpdate/PeriodicUpdateCheck.cs
@@ -0,0 +1,56 @@
+using System.Threading.Tasks;
+
+namespace Dalamud.Plugin.Internal.AutoUpdate;
+
+/// <summary>
+/// Owns one repository refresh until its result is consumed by the framework thread.
+/// </summary>
+internal sealed class PeriodicUpdateCheck
+{
+    private Task? pending;
+
+    /// <summary>Gets a value indicating whether a refresh or its unconsumed result exists.</summary>
+    public bool IsPending => this.pending != null;
+
+    /// <summary>Starts a refresh if the previous result has been consumed.</summary>
+    /// <param name="reload">The repository refresh operation.</param>
+    /// <returns>Whether a new refresh was started.</returns>
+    public bool TryStart(Func<Task> reload)
+    {
+        if (this.pending != null)
+            return false;
+
+        try
+        {
+            this.pending = reload();
+        }
+        catch (Exception ex)
+        {
+            this.pending = Task.FromException(ex);
+        }
+
+        return true;
+    }
+
+    /// <summary>Consumes a completed refresh exactly once, without blocking or scheduling a callback.</summary>
+    /// <param name="error">The observed refresh error, if any.</param>
+    /// <returns>Whether a completed result was consumed.</returns>
+    public bool TryComplete(out Exception? error)
+    {
+        error = null;
+        if (this.pending is not { IsCompleted: true } completed)
+            return false;
+
+        this.pending = null;
+        try
+        {
+            completed.GetAwaiter().GetResult();
+        }
+        catch (Exception ex)
+        {
+            error = ex;
+        }
+
+        return true;
+    }
+}
