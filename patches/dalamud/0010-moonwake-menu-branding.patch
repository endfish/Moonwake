diff --git a/Dalamud.Test/Game/Gui/ContextMenu/MenuItemPrefixTests.cs b/Dalamud.Test/Game/Gui/ContextMenu/MenuItemPrefixTests.cs
new file mode 100644
--- /dev/null
+++ b/Dalamud.Test/Game/Gui/ContextMenu/MenuItemPrefixTests.cs
@@ -0,0 +1,51 @@
+using System.Linq;
+
+using Dalamud.Game.Gui.ContextMenu;
+using Dalamud.Game.Text;
+using Dalamud.Game.Text.SeStringHandling.Payloads;
+
+using Xunit;
+
+namespace Dalamud.Test.Game.Gui.ContextMenu;
+
+public class MenuItemPrefixTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void LegacyDefaultFromCompiledPluginUsesMoonwakeBrand(bool useDefaultPrefix)
+    {
+        var name = global::Dalamud.Game.Gui.ContextMenu.ContextMenu.GetPrefixedName(new MenuItem
+        {
+            Name = "Plugin action",
+            Prefix = SeIconChar.BoxedLetterD,
+            PrefixColor = 539,
+            UseDefaultPrefix = useDefaultPrefix,
+        });
+
+        Assert.Equal(SeIconChar.BoxedLetterM.ToIconString() + " Plugin action", name.TextValue);
+        Assert.Equal((ushort)517, name.Payloads.OfType<UIForegroundPayload>().First().ColorKey);
+    }
+
+    [Fact]
+    public void CustomPluginBrandIsPreserved()
+    {
+        var name = global::Dalamud.Game.Gui.ContextMenu.ContextMenu.GetPrefixedName(new MenuItem
+        {
+            Name = "Plugin action",
+            Prefix = SeIconChar.BoxedLetterP,
+            PrefixColor = 56,
+        });
+
+        Assert.Equal(SeIconChar.BoxedLetterP.ToIconString() + " Plugin action", name.TextValue);
+        Assert.Equal((ushort)56, name.Payloads.OfType<UIForegroundPayload>().First().ColorKey);
+    }
+
+    [Fact]
+    public void UnprefixedSubmenuEntryStaysUnprefixed()
+    {
+        var name = global::Dalamud.Game.Gui.ContextMenu.ContextMenu.GetPrefixedName(new MenuItem { Name = "Plugin action" });
+        Assert.Equal("Plugin action", name.TextValue);
+        Assert.Empty(name.Payloads.OfType<UIForegroundPayload>());
+    }
+}
