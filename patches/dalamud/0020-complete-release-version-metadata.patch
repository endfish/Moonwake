diff --git a/Dalamud.Test/Utility/VersionMetadataTests.cs b/Dalamud.Test/Utility/VersionMetadataTests.cs
new file mode 100644
--- /dev/null
+++ b/Dalamud.Test/Utility/VersionMetadataTests.cs
@@ -0,0 +1,15 @@
+using Dalamud.Utility;
+using Xunit;
+
+namespace Dalamud.Test.Utility;
+
+public class VersionMetadataTests
+{
+    [Fact]
+    public void EntryPointVersionReadsSucceedForPackagedCore()
+    {
+        Assert.False(string.IsNullOrWhiteSpace(Versioning.GetScmVersion()));
+        Assert.False(string.IsNullOrWhiteSpace(Versioning.GetGitHashClientStructs()));
+        Assert.False(string.IsNullOrWhiteSpace(Versioning.GetGitBranch()));
+    }
+}
