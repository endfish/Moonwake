diff --git a/Dalamud.Test/Storage/AssetDefinitionTests.cs b/Dalamud.Test/Storage/AssetDefinitionTests.cs
new file mode 100644
index 000000000..0a25d1d93
--- /dev/null
+++ b/Dalamud.Test/Storage/AssetDefinitionTests.cs
@@ -0,0 +1,17 @@
+using Dalamud.Storage.Assets;
+
+using Xunit;
+
+namespace Dalamud.Test.Storage;
+
+public class AssetDefinitionTests
+{
+    [Fact]
+    public void WhiteTextureUsesEmbeddedData()
+    {
+        var attribute = DalamudAsset.White4X4.GetAssetAttribute();
+        Assert.Equal(DalamudAssetPurpose.TextureFromRaw, attribute.Purpose);
+        Assert.NotNull(attribute.Data);
+        Assert.Equal(8, attribute.Data.Length);
+    }
+}
