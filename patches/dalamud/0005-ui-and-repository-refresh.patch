diff --git a/Dalamud.Test/Plugin/RepositorySnapshotTests.cs b/Dalamud.Test/Plugin/RepositorySnapshotTests.cs
new file mode 100644
index 000000000..9acf01f54
--- /dev/null
+++ b/Dalamud.Test/Plugin/RepositorySnapshotTests.cs
@@ -0,0 +1,60 @@
+using System;
+using System.Net;
+using System.Net.Http;
+using System.Threading;
+using System.Threading.Tasks;
+
+using Dalamud.Plugin.Internal.Types;
+
+using Xunit;
+
+namespace Dalamud.Test.Plugin;
+
+public class RepositorySnapshotTests
+{
+    [Fact]
+    public async Task Refresh_RetainsVisibleSnapshotUntilSuccessfulReplacement()
+    {
+        using var handler = new ControlledHandler();
+        using var client = new HttpClient(handler);
+        var repository = new PluginRepository(client, "https://example.test/repo.json", true);
+        await repository.ReloadAsync();
+        var original = repository.PluginMaster;
+        Assert.NotNull(original);
+        Assert.Equal("First", Assert.Single(original).Name);
+
+        var refresh = repository.ReloadAsync();
+        Assert.False(refresh.IsCompleted);
+        Assert.Equal(PluginRepositoryState.InProgress, repository.State);
+        Assert.Same(original, repository.PluginMaster);
+        handler.Pending.SetResult(new HttpResponseMessage(HttpStatusCode.ServiceUnavailable));
+        await refresh;
+        Assert.Equal(PluginRepositoryState.Fail, repository.State);
+        Assert.Same(original, repository.PluginMaster);
+
+        await repository.ReloadAsync();
+        Assert.Equal(PluginRepositoryState.Success, repository.State);
+        Assert.Equal("Updated", Assert.Single(repository.PluginMaster!).Name);
+        Assert.Equal(3, handler.Requests);
+    }
+
+    private sealed class ControlledHandler : HttpMessageHandler
+    {
+        public TaskCompletionSource<HttpResponseMessage> Pending { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+
+        public int Requests { get; private set; }
+
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            this.Requests++;
+            if (this.Requests == 2)
+                return this.Pending.Task;
+
+            var name = this.Requests == 1 ? "First" : "Updated";
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)
+            {
+                Content = new StringContent("[{\"InternalName\":\"Example\",\"Name\":\"" + name + "\",\"AssemblyVersion\":\"1.0.0\",\"DalamudApiLevel\":15}]"),
+            });
+        }
+    }
+}
