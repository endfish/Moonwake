@@ -0,0 +1,19 @@
+using System;
+using SQLite;
+using Xunit;
+
+namespace Dalamud.Test.Utility;
+
+public class SqliteRuntimeTests
+{
+    [Fact]
+    public void BundledNativeSqliteContainsSecurityFix()
+    {
+        using var connection = new SQLiteConnection(":memory:");
+        var version = Version.Parse(connection.ExecuteScalar<string>("SELECT sqlite_version()"));
+        Assert.True(version >= new Version(3, 50, 2), $"Unexpected native SQLite version: {version}");
+        connection.Execute("CREATE TABLE Settings (Name TEXT PRIMARY KEY, Value TEXT)");
+        connection.RunInTransaction(() => connection.Execute("INSERT INTO Settings VALUES (?, ?)", "profile", "中文配置"));
+        Assert.Equal("中文配置", connection.ExecuteScalar<string>("SELECT Value FROM Settings WHERE Name = ?", "profile"));
+    }
+}
